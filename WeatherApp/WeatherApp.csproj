<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**;WeatherApp\**</DefaultItemExcludes>
  </PropertyGroup>

  <Target Name="StopOldWeatherApp" BeforeTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="cmd /c &quot;taskkill /F /IM WeatherApp.exe /T &gt;nul 2&gt;nul || exit /b 0&quot;" />
  </Target>

</Project>
